@using SSSFramework;
@{
    ViewBag.Title = DDA.Resources.Resource.Common_Error;
}

<div class="row h-100">
    <div class="col-md-12">
        <div class="d-flex h-100 align-items-center justify-content-center">
            <img src="~/Content/images/errors/ServerError.svg" class="mr-5" style="width:100%; max-width: 300px;object-fit: contain;}" />
            <div class="text-left d-flex flex-column align-items-start justify-content-center" style="width:400px">
                <h6 id="errorTitle" class="mb-4" style="font-size:2rem;">@DDA.Resources.Resource.Common_ErrorOccured</h6>
                <div id="ExceptinDetails">
                    <p>@Html.Raw(ViewBag.ExceptionMessage)</p>
                </div>
                <div>
                    <button class="btn btn-primary mt-3 mx-0 mr-2" value="Back" onclick="window.history.back();">@DDA.Resources.Resource.Button_Back</button>
                </div>
            </div>
        </div>
    </div>
</div>
