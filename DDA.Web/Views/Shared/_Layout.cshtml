@using SSSFramework;
<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <link rel="icon" href="~/Content/images/icons/favicon.ico">
    <meta http-equiv="X-UA-Compatible" content="IE=9; IE=10; IE=11; IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@DDA.Resources.Resource.ApplicationName</title>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery-migrate-3.0.0.min.js"></script>
    <script src="~/Scripts/jquery.easyWizard.min.js"></script>


    <link href="~/Content/shared/fontawesome-free-5.13.1-web/css/all.min.css" rel="stylesheet" />

    <link href="~/Scripts/Select2/css/select2-bootstrap4.css" rel="stylesheet" />


    @if (CultureHelper.IsArabic)
    {
        <link href="~/Content/calendar/css/jquery-ui.min.rtl.css" rel="stylesheet" />
        <link href="~/Content/calendar/css/jquery.calendars.picker.min.rtl.css" rel="stylesheet" />
        <link href="~/Content/shared/animate/animate.rtl.css" rel="stylesheet" />
        <link href="~/Content/shared/bootstrap/css/bootstrap.min.rtl.css" rel="stylesheet" />
        <link href="~/Scripts/Select2/css/select2.min.rtl.css" rel="stylesheet" />
        <link href="~/Content/kendo/web/kendo.common.min.rtl.css" rel="stylesheet" />
        <link href="~/Content/kendo/web/kendo.rtl.min.css" rel="stylesheet" />
        <link href="~/Content/kendo/kendo.custom.rtl.css" rel="stylesheet" />
        <link href="~/Content/css/main-admin.rtl.css" rel="stylesheet" />
    }
    else
    {
        <link href="~/Content/calendar/css/jquery-ui.min.css" rel="stylesheet" />
        <link href="~/Content/calendar/css/jquery.calendars.picker.min.css" rel="stylesheet" />
        <link href="~/Content/shared/animate/animate.css" rel="stylesheet" />
        <link href="~/Content/shared/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/Scripts/Select2/css/select2.min.css" rel="stylesheet" />
        <link href="~/Content/kendo/web/kendo.common.min.css" rel="stylesheet" />
        <link href="~/Content/kendo/kendo.custom.css" rel="stylesheet" />
        <link href="~/Content/css/main-admin.css" rel="stylesheet" />
    }

</head>
<body>

    <div class="container-fluid p-0 h-100">
        <div class="row h-100 no-gutters">
            <div class="col-md-3 side-menu text-center animated fadeIn px-5 py-4" id="mainMenu">
                <a class="navbar-brand animated slideInLeft mb-4 py-0 black-color" href="@Url.Action("Index", "Home")">
                    @DDA.Resources.Resource.ApplicationName
                </a>
                <div class="accordion animated slideInLeft" id="accordion1">
                    <ul class="nav flex-column text-left">
                        <li>
                            <a href="@Url.Action("Upload", "Home")" class="nav-link rounded" id="divUpload">
                                <i class="fas fa-file-alt mr-3"></i>@DDA.Resources.Resource.Upload
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Spin", "Home")" class="nav-link rounded" id="divSpin">
                                <i class="fas fa-th-large mr-3"></i>@DDA.Resources.Resource.Spin
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-9 d-flex flex-column main-section min-vh-100">
                <nav class="navbar navbar-light p-3 px-md-5 py-md-5">
                    <div class="d-flex">
                        <h4 class="h4-responsive text-dark font-weight-bold animated slideInDown mb-0">@ViewBag.Title</h4>
                    </div>

                    <div class="d-flex align-items-center animated fadeIn">
                        <a class="h5 pl-3 mb-0 grey-color text-dark-grey menu-icon" href="@Url.Action("SwitchLanguage","Base", new { lang = DDA.Resources.Resource.Common_OtherLanguageCode})">
                            <i class="fas fa-language"></i>
                        </a>

                    </div>
                </nav>
                <div class="py-0 px-3 px-md-5 pt-md-0 pb-md-4 flex-grow-1">

                    @Html.Partial("_Notification")

                    @RenderBody()

                </div>
                <footer class="footer bg-grey4 px-4 py-2">
                    <p class="mb-0 small">&copy; @DateTime.Now.Year - @DDA.Resources.Resource.CopyRights</p>
                </footer>

            </div>

        </div>
    </div>

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/bootbox.min.js"></script>
    <script src="~/Content/calendar/jquery-ui.min.js"></script>
    <script src="~/Content/calendar/culture/globalize.min.js"></script>
    <script src="~/Content/shared/fontawesome-free-5.13.1-web/js/all.min.js"></script>
    <script src="~/Scripts/utils.js"></script>
    <script src="~/Scripts/tether.min.js"></script>
    <script src="~/Scripts/popper.js"></script>
    <script src="~/Content/shared/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/Scripts/Select2/js/select2.min.js"></script>
    <script src="~/Content/kendo/Scripts/kendo.all.min.js"></script>
    <script src="~/Content/kendo/Scripts/kendo.aspnetmvc.min.js"></script>
    <script src="~/Content/kendo/Scripts/kendo.timezones.min.js"></script>
    <script src="~/Content/calendar/jquery.plugin.min.js"></script>
    <script src="~/Content/calendar/jquery.calendars.min.js"></script>
    <script src="~/Content/calendar/jquery.calendars-ar.js.js"></script>
    <script src="~/Content/calendar/jquery.calendars.plus.min.js"></script>
    <script src="~/Content/calendar/jquery.calendars.picker.min.js"></script>
    <script src="~/Content/calendar/jquery.calendars.picker-ar.js"></script>
    <script src="~/Content/calendar/jquery.calendars.ummalqura.min.js"></script>
    <script src="~/Content/calendar/jquery.calendars.ummalqura-ar.js"></script>
    <script src="~/Scripts/jquery.mask.min.js"></script>
    <script src="~/Scripts/Site.js"></script>
    <script src="~/Scripts/Extensions.js"></script>

</body>
</html>
<script type="text/javascript">
    var baseUrl = "http://localhost/DDA.Web";
    var _ArabicFieldValidation = '@DDA.Resources.Resource.ArabicFieldValidation';
    var _EnglishFieldValidation = '@DDA.Resources.Resource.EnglishFieldValidation';

    $(document).ready(function () {
        inilitizeCalanders(true, true);
        $('.js-example-basic-single').select2();
        $('.js-example-basic-multiple').select2();
    });
     var _SystemLanguge = '@CultureHelper.CultureName';
    $(document).ajaxStart(function (e) { });
    $(document).ajaxStop(function () { });
    $(document).ajaxSend(function (event, xhr, options) {
        if (options.type !== 'POST') {
            return;
        }

        if (options.data != undefined && options.data != [] && options.data != null && options.data != '') {
            var token = $('input[name="__RequestVerificationToken"]').val();
            if (token != '')
                options.data = options.data + "&__RequestVerificationToken=" + token;
        }
    });

    function searchGrid(gridId) {
        $("#" + gridId).data('kendoGrid').dataSource.page(1);
        $("#" + gridId).data('kendoGrid').dataSource.pageSize(10);
        $("#" + gridId).data("kendoGrid").dataSource.read();
    }
</script>

<script>
    $(document).ready(function () {
        if (window.location.href.indexOf("/Upload") > -1) {
            $("#divUpload").addClass("active");
        } else if (window.location.href.indexOf("/Spin") > -1) {
            $("#divSpin").addClass("active");
        } else {
            $("#divUpload").addClass("active");
        }
    })
</script>