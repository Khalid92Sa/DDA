@using Kendo.Mvc.UI
@using SSSFramework;
@model DDA.ViewModels.Kendo.KendoGridViewModel

@{
    var resourceType = Model.ResourceType;
    var deleteMessage = !string.IsNullOrEmpty(Model.DeleteMessageResourceKey) ? ResourceHelper.Resources.Get(Model.DeleteMessageResourceKey, resourceType) : string.Empty;
    var exportToPdfText = !string.IsNullOrEmpty(Model.ExportToPdfButtonResourceKey) ? ResourceHelper.Resources.Get(Model.ExportToPdfButtonResourceKey, resourceType) : string.Empty;
    var exportToExcelText = !string.IsNullOrEmpty(Model.ExportToExcelButtonResourceKey) ? ResourceHelper.Resources.Get(Model.ExportToExcelButtonResourceKey, resourceType) : string.Empty;
    var addNewText = !string.IsNullOrEmpty(Model.AddNewResourceKey) ? ResourceHelper.Resources.Get(Model.AddNewResourceKey, resourceType) : string.Empty;
    var customButtonText = Model.EnableCustomButtonStaticText ? ResourceHelper.Resources.Get(Model.CustomButtonTextStatic, resourceType) : (!string.IsNullOrEmpty(Model.CustomButtonResourceKey) ? ResourceHelper.Resources.Get(Model.CustomButtonResourceKey, resourceType) : "Custom");
    var customButtonTwoStateText = Model.EnableTwoStateTextForCustomButton ? ResourceHelper.Resources.Get(Model.TwoStateTextResourceKeyForCustomButton, resourceType) : "";
    var addnewButtonText = !string.IsNullOrEmpty(Model.AddNewResourceKey) ? ResourceHelper.Resources.Get(Model.AddNewResourceKey, resourceType) : "Add New";
    var editButtonText = !string.IsNullOrEmpty(Model.EditButtonResourceKey) ? ResourceHelper.Resources.Get(Model.EditButtonResourceKey, resourceType) : "Edit";
    var editButtonTwoStateText = Model.EnableTwoStateTextForEditButton ? ResourceHelper.Resources.Get(Model.TwoStateTextResourceKeyForEditButton, resourceType) : "";
    var viewButtonText = !string.IsNullOrEmpty(Model.ViewButtonResourceKey) ? ResourceHelper.Resources.Get(Model.ViewButtonResourceKey, resourceType) : "View";
    var viewButtonTwoStateText = Model.EnableTwoStateTextForViewButton ? ResourceHelper.Resources.Get(Model.TwoStateTextResourceKeyForViewButton, resourceType) : "";
    var deleteButtonText = !string.IsNullOrEmpty(Model.DeleteButtonResourceKey) ? ResourceHelper.Resources.Get(Model.DeleteButtonResourceKey, resourceType) : "Delete";
    var deleteButtonTwoStateText = Model.EnableTwoStateTextForDeleteButton ? ResourceHelper.Resources.Get(Model.TwoStateTextResourceKeyForDeleteButton, resourceType) : "";
    var enablePopupDeleteMessage = ResourceHelper.Resources.Get("EnableOpportunityMsg", resourceType);
    var disablePopupDeleteMessage = ResourceHelper.Resources.Get("DisableOpportunityMsg", resourceType);
    Model.Height = !string.IsNullOrEmpty(Model.Height) ? Model.Height : "500px";
}

