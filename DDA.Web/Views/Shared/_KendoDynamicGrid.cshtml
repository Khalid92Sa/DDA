<script type="text/javascript">
    //** Global variables
    var @(Model.GridName)_totalSelectedCheckboxes = 0;
    var @(Model.GridName)_selectedArray = new Array();

    $(document).ready(function () {
        $('#@Model.GridName').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#@Model.GridName').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            // dataItem.IsChecked = checked;
            if('@Model.EnableCustomSelect' == 'True')
            {
                @(Model.EnableCustomSelectJSName)(checked , dataItem);
            }
            if (checked == false) {
                $("#@(Model.GridName)checkAll").attr('checked', false);
                if (@(Model.GridName)_totalSelectedCheckboxes != 0) {
                    @(Model.GridName)_totalSelectedCheckboxes--;

                    var rowIndex;
                    $.each(@(Model.GridName)_selectedArray, function (index, value) {
                        if (value.@(Model.IdViewModuleIsHidden ? Model.IdViewModuleName + "_hidden" : Model.IdViewModuleName) == dataItem.@(Model.IdViewModuleIsHidden ? Model.IdViewModuleName + "_hidden" : Model.IdViewModuleName)) {
                            rowIndex = index;
                        }
                    });
                    @(Model.GridName)_selectedArray.splice(rowIndex, 1);
                }
            }
            else {
                @(Model.GridName)_totalSelectedCheckboxes++;
                @(Model.GridName)_selectedArray.push(dataItem);

                if (@(Model.GridName)_totalSelectedCheckboxes == grid._data.length && @(Model.GridName)_totalSelectedCheckboxes > 0) {
                    $("#@(Model.GridName)checkAll").prop('checked', true);
                }
            }
        })
    });

    function @(Model.GridName)_selectAll(element    ) {
        var state = $(element).is(':checked');
        if('@Model.EnableCustomSelectAll' == 'True')
        {
            @(Model.EnableCustomSelectAllJSName)(state , element);
            return;
        }


        var grid = $('#@Model.GridName').data().kendoGrid;
        @(Model.GridName)_selectedArray = [];
        @(Model.GridName)_totalSelectedCheckboxes = 0;
        $.each(grid.dataSource.view(), function () {
            // this.IsChecked = state;
            if (state) {
                @(Model.GridName)_selectedArray.push(this);
                @(Model.GridName)_totalSelectedCheckboxes++;
            }
        });
        grid.refresh();
        $('.chkbx').attr('checked', state);
    }

    function @(Model.GridName)_readWrapper() {
       //debugger;
        var readUrl = '@Url.Action(Model.FillDataActionName, Model.Controller)';
        var page;
        var pageSize;
        var isPageable = @Model.Pageable.ToString().ToLower();
        if(isPageable)
        {
            page = $("#@Model.GridName").data('kendoGrid').dataSource.page();
            pageSize = $("#@Model.GridName").data('kendoGrid').dataSource.pageSize();
        }
        else{
            page = 1;
            pageSize = @(int.MaxValue);
        }
        return @(Model.ReadJsFunctionName)(page, pageSize, readUrl); //** Call the read js function.
    }

    function @(Model.GridName)_viewRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var idValue = dataItem['@(Model.IdViewModuleIsHidden ? Model.IdViewModuleName + "_hidden" : Model.IdViewModuleName)'];
        if (idValue == undefined)
            idValue = dataItem['@Model.IdViewModuleName'];

        @{
            if (Model.CallJsFunctionOnViewButton)
            {
                @(Model.ViewButtonJsFunctionName + "(idValue);")
            }
            else
            {
                @:window.location.href = '@Url.Action(Model.ViewActionName, Model.Controller)?@Model.IdQueryStringName=' + idValue;
                    }
        }
    }

    function @(Model.GridName)_editRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var idValue = dataItem['@(Model.IdViewModuleIsHidden ? Model.IdViewModuleName + "_hidden" : Model.IdViewModuleName)'];
        if (idValue == undefined)
            idValue = dataItem['@Model.IdViewModuleName'];

        @{
            if (Model.CallJsFunctionOnEditButton)
            {
              @(Model.EditButtonJsFunctionName + "(idValue);")
            }
            else
            {
              @:window.location.href = '@Url.Action(Model.EditActionName, Model.Controller)?@Model.IdQueryStringName=' + idValue;
                    }
         }
    }

    function @(Model.GridName)_deleteRow(e) {
        e.preventDefault();

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var msg = false;

        var isDeleted = dataItem['IsDeleted'];
        var confirmMessage = isDeleted ? '@enablePopupDeleteMessage' : '@disablePopupDeleteMessage';

        if (typeof bootbox != 'undefined') {
            bootbox.confirm({
                message: confirmMessage,
                buttons: {
                    confirm: {
                        label: '@DDA.Resources.Resource.Common_Yes',
                        // className: 'btn-success'
                    },
                    cancel: {
                        label: '@DDA.Resources.Resource.Common_No',
                        // className: 'btn-danger'
                    }
                },
                callback: function (result) {
                    msg = result;
                    @(Model.GridName + "_doDelete(e, dataItem, msg);")
                }
            });
        }
        else {
            msg = confirm('@deleteMessage');
            @(Model.GridName + "_doDelete(e, dataItem, msg);")
        }
    }

    function @(Model.GridName)_doDelete(e, dataItem, msg) {
        if (!msg) {
            e.stopImmediatePropagation();
            e.stopPropagation();
            return false;
        } else {
            var idValue = dataItem['@(Model.IdViewModuleIsHidden ? Model.IdViewModuleName + "_hidden" : Model.IdViewModuleName)'];

            if (idValue == undefined)
                idValue = dataItem['@Model.IdViewModuleName'];

            @{
                if (Model.CallJsFunctionOnDeleteButton)
                {
                    @(Model.DeleteButtonJsFunctionName + "(idValue, e, dataItem);")
                }
                else
                {
                    @:window.location.href = '@Url.Action(Model.DeleteActionName, Model.Controller)?@Model.IdQueryStringName=' + idValue;
                            }
            }
        }
    }

    @{
       if (Model.ShowCustomButton)
       {
             <text>
    function @(Model.GridName)_customRow(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var idValue = dataItem['@(Model.IdViewModuleIsHidden ? Model.IdViewModuleName + "_hidden" : Model.IdViewModuleName)'];

        if (idValue == undefined)
            idValue = dataItem['@Model.IdViewModuleName'];

        @{
                        if (Model.CallJsFunctionOnCustomButton)
                        {
                          @(Model.CustomButtonJsFunctionName + "(idValue);")
                        }
                        else
                        {
                            @:window.location.href = '@Url.Action(Model.CustomButtonActionName, Model.Controller)?@Model.IdQueryStringName=' + idValue;
                                }
                    }
    }
    </text>
       }
    }
</script>

<script type="text/javascript">
    function @(Model.GridName)_exportThis(e) {
        var grid = $('#@Model.GridName').data('kendoGrid');

        // ask the parameterMap to create the request object for you
        var requestObject = (new kendo.data.transports["aspnetmvc-server"]({ prefix: "" }))
            .options.parameterMap({
                page: grid.dataSource.page(),
                sort: grid.dataSource.sort(),
                filter: grid.dataSource.filter()
            });

        // Get the export link as jQuery object
        var $exportLink = $(e);
        // Get its 'href' attribute - the URL where it would navigate to
        var href = $exportLink.attr('href');
        // Update the 'page' parameter with the grid's current page
        href = href.replace(/page=([^&]*)/, 'page=' + (requestObject.page || '#'));
        // Update the 'sort' parameter with the grid's current sort descriptor
        href = href.replace(/sort=([^&]*)/, 'sort=' + (requestObject.sort || '#'));
        // Update the 'pageSize' parameter with the grid's current pageSize
        href = href.replace(/pageSize=([^&]*)/, 'pageSize=' + (grid.dataSource._pageSize || '#'));
        //update filter descriptor with the filters applied
        href = href.replace(/filter=([^&]*)/, 'filter=' + (requestObject.filter || '#'));
        // Update the 'href' attribute
        $exportLink.attr('href', href);
    }
</script>

<script>
    function @(Model.GridName)_dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
