            //** Two state for View button.
            //*****************************************

            if (Model.EnableCustomRowBound)
            {
                <text>
                 var Rowsdata =  this.dataSource.view();
                 var selected = @(Model.CustomRowBoundName)(Rowsdata);

                for (var i=0; i < Rowsdata.length; i++)
                {

                    var dataItem = Rowsdata[i];
                    var row = $("#@Model.GridName").find("[data-uid='" + dataItem.uid + "']");

                    if(selected.indexOf(dataItem.Id) !== -1)
                    {

                        $(row).find('.chkbx').prop('checked' , true);
                    }

                }
               </text>
            }
            if (Model.EnableTwoStateTextForViewButton)
