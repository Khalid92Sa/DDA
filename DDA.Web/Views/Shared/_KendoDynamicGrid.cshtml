<div id="@(Model.GridName)Area" class="@(CultureHelper.IsArabic ? "k-rtl" : "")">
    @(Html.Kendo().Grid(Model.Data)
          .Name(Model.GridName)
          .Columns(columns =>
          {
          if (Model.FixedActionButtonsFirstColumn)
          {
              if (Model.ShowDeleteButton || Model.ShowEditButton || Model.ShowViewButton || Model.ShowCustomButton)
              {
                  columns.Command(command =>
                  {
                      if (Model.ShowViewButton)
                          command.Custom(!Model.EnableTwoStateTextForViewButton ? viewButtonText : " ").Click(Model.GridName + "_viewRow").HtmlAttributes(new { id = Model.GridName + "_viewItem", title = viewButtonText });
                      if (Model.ShowEditButton)
                          command.Custom(!Model.EnableTwoStateTextForEditButton ? editButtonText : " ").Click(Model.GridName + "_editRow").HtmlAttributes(new { id = Model.GridName + "_editItem", title = editButtonText });
                      if (Model.ShowDeleteButton)
                          command.Custom(!Model.EnableTwoStateTextForDeleteButton ? deleteButtonText : " ").Click(Model.GridName + "_deleteRow").HtmlAttributes(new { id = Model.GridName + "_deleteItem", title = deleteButtonText });
                      if (Model.ShowCustomButton)
                          command.Custom(!Model.EnableTwoStateTextForCustomButton ? customButtonText : " ").Click(Model.GridName + "_customRow").HtmlAttributes(new { id = Model.GridName + "_customItem", title = customButtonText });
                  }).Width(Model.ActionsColumnWidth).Locked(Model.EnableFixedActionButtons).Lockable(false);
              }
          }

          if (Model.ShowRowSelectCheckBox)
          {
              columns.Template(@<text></text>).ClientTemplate("<input type='checkbox'  class='chkbx' />")
                    .HeaderTemplate("<input type='checkbox' id='" + Model.GridName + "checkAll' onclick='" + Model.GridName + "_selectAll(this)'/>").Width(30);
              }

              foreach (System.Data.DataColumn column in Model.Data.Columns)
              {
                  var columnWidth = (column.Caption != "-1") ? Convert.ToInt32(column.Caption) : 170;
                  var colName = column.ColumnName.ToLower().Contains("_readonly") ? column.ColumnName.Replace("_readonly", string.Empty) : column.ColumnName;
                  var title = ResourceHelper.Resources.Get(colName + "_Title", resourceType);
                  if (Model.Data != null)
                  {
                      if (column.ColumnName.ToLower().Contains("_hidden"))
                      {
                          //var fieldIndex = column.ColumnName.IndexOf("_hidden", System.StringComparison.Ordinal);
                          //var columnName = column.ColumnName.Remove(fieldIndex, column.ColumnName.Length - fieldIndex);
                          columns.Bound(column.ColumnName).Hidden().Visible(false);
                      }
                      else
                      {
                          if (column.DataType == typeof(DateTime))
                              columns.Bound(column.ColumnName).Width(columnWidth).Filterable(x => x.Enabled(Model.Filterable).Cell(cell => cell.Operator("contains"))).Title(title).EditorTemplateName("String").Format("{0:dd/MM/yyyy}");
                          else
                              columns.Bound(column.ColumnName).Width(columnWidth).Filterable(x => x.Enabled(Model.Filterable).Cell(cell => cell.Operator("contains"))).Title(title).EditorTemplateName("String");
                      }
                  }
              }

              if (!Model.FixedActionButtonsFirstColumn)
              {
                  if (Model.ShowDeleteButton || Model.ShowEditButton || Model.ShowViewButton || Model.ShowCustomButton)
                  {
                      columns.Command(command =>
                      {
                          if (Model.ShowViewButton)
                              command.Custom(!Model.EnableTwoStateTextForViewButton ? viewButtonText : " ").Click(Model.GridName + "_viewRow").HtmlAttributes(new { id = Model.GridName + "_viewItem", title = viewButtonText });
                          if (Model.ShowEditButton)
                              command.Custom(!Model.EnableTwoStateTextForEditButton ? editButtonText : " ").Click(Model.GridName + "_editRow").HtmlAttributes(new { id = Model.GridName + "_editItem", title = editButtonText });
                          if (Model.ShowDeleteButton)
                              command.Custom(!Model.EnableTwoStateTextForDeleteButton ? deleteButtonText : " ").Click(Model.GridName + "_deleteRow").HtmlAttributes(new { id = Model.GridName + "_deleteItem", title = deleteButtonText });
                          if (Model.ShowCustomButton)
                              command.Custom(!Model.EnableTwoStateTextForCustomButton ? customButtonText : " ").Click(Model.GridName + "_customRow").HtmlAttributes(new { id = Model.GridName + "_customItem", title = customButtonText });
                      }).Width(Model.ActionsColumnWidth);
                  }
              }
          })
    .HtmlAttributes(new { style = "height:" + Model.Height + ";" })
    .Editable(x => x.Enabled(Model.Editable).Mode(GridEditMode.InCell))
    .Scrollable(x => x.Enabled(Model.Scrollable))
    .Groupable(x => x.Enabled(Model.Groupable))
    .Sortable(x => x.Enabled(Model.Sortable))
    //   .ClientDetailTemplateId(Model.DetailsTemplateName)
    .Filterable(ftb => ftb.Mode(GridFilterMode.Row))
    .ColumnMenu(x => x.Enabled(Model.EnableColumnMenu))
    .Pageable(x => x.Enabled(Model.Pageable)
    .Refresh(true)
    .PageSizes(new int[] { 5, 10, 20, 50, 100, 500 })
    .ButtonCount(5))
    .Selectable(x => x.Enabled(Model.Selectable)
    .Mode(GridSelectionMode.Single))
    .DataSource(dataSource => dataSource
    .Ajax().Total(Model.Total)
    .Model(model =>
    {
        string id = Model.Data.Columns[0].ColumnName;
        foreach (System.Data.DataColumn column in Model.Data.Columns)
        {
            if (column.ColumnName.Contains("_readonly"))
                model.Field(column.ColumnName, column.DataType);//.Editable(false);
            else
                model.Field(column.ColumnName, column.DataType);
        }

        model.Id(id);
    })
    .Read(read =>
    {
        if (!Model.UseReadParameter || string.IsNullOrEmpty(Model.ReadJsFunctionName))
            read.Action(Model.FillDataActionName, Model.Controller);
        else
        {
            read.Action(Model.FillDataActionName, Model.Controller).Data(Model.GridName + "_readWrapper"); //, new { readParameter = ViewData["ReadParameterValue"], readParameter2 = ViewData["SecondReadParameterValue"], readParameter3 = ViewData["ThirdReadParameterValue"] });
        }
    }
    ).PageSize(Model.DefualtPageSize))
    .ToolBar(toolbar =>
    {
        if (Model.ShowAddNewButton)
        {
            if (Model.CallJsFunctionOnAddNewButton)
            {
                toolbar.Custom()
                .Text(addNewText)
                .HtmlAttributes(new { id = Model.GridName + "_addPopup", onclick = Model.AddButtonJsFunctionName + "()", href = "javascript:void(0);" });
            }
            else
            {
                toolbar.Custom()
                .Text(addNewText)
                .HtmlAttributes(new { id = Model.GridName + "_addNew" })
                .Action(Model.AddNewActionName, Model.Controller);
            }
        }

        if (Model.ShowExportToPdfButton)
        {
            toolbar.Custom()
            .Text(exportToPdfText)
            .HtmlAttributes(new { id = Model.GridName + "_exportPdf", onclick = Model.GridName + "_exportThis(this)" })
            .Url(Url.Action(Model.ExportToPdfActionName, Model.Controller, new { page = 1, pageSize = "#", filter = "#", sort = "#" }));
        }

        if (Model.ShowExportToExcelButton)
        {
            toolbar.Custom()
            .Text(exportToExcelText)
            .HtmlAttributes(new { id = Model.GridName + "_exportExcel", onclick = Model.GridName + "_exportThis(this)" })
            .Url(Url.Action(Model.ExportToExcelActionName, Model.Controller, new { page = 1, pageSize = "#", filter = "#", sort = "#" }));
        }
    })
    .Resizable(resize => resize.Columns(true))
    .Reorderable(reorder => reorder.Columns(true))
    .Navigatable(x => x.Enabled(Model.Navigatable))
    .Events(e => e.DataBound(Model.GridName + "_onRowBound")))
</div>

<script type="text/javascript">
    $(document).ready(function () {
        @{
            if (!Model.Filterable)
            {
                @: $("#@(Model.GridName) .k-filter-row").remove();
                    }
        }
    });
</script>
