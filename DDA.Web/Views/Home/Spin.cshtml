@{
    ViewBag.Title = "Spin";
}

<style type="text/css">
    .wheel-stage {
        position: relative;
        display: inline-block;
    }

    .wheel-pointer {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        z-index: 5;
        border-left: 22px solid transparent;
        border-right: 22px solid transparent;
        border-top: 44px solid #e65727;
        filter: drop-shadow(0 3px 3px rgba(0,0,0,.35));
    }

    .wheel-hub {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 70px;
        height: 70px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: #fff;
        border: 6px solid #333;
        box-shadow: 0 0 10px rgba(0,0,0,.4);
    }

    #winnerBox {
        min-height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 7rem;
        font-weight: 800;
        line-height: 1;
        color: #1b7f3b;
        letter-spacing: 4px;
    }

        #winnerBox.pop {
            animation: pop .6s ease-out;
        }

    @@keyframes pop {
        0% {
            transform: scale(.3);
            opacity: 0;
        }

        70% {
            transform: scale(1.15);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    #btnSpin {
        font-size: 1.6rem;
        padding: .6rem 3rem;
        border-radius: 50px;
    }

    .history-item {
        font-size: 1.4rem;
        font-weight: 700;
    }
</style>
@Html.AntiForgeryToken()
<div class="row">
    <div class="col-lg-3 mb-4">
        <div class="bg-grey4 rounded p-4">
            <label for="campaignId">Campaign</label>
            <select id="campaignId" class="form-control">
                <option value="">@DDA.Resources.Resource.Campaign_Select</option>
            </select>
            <div class="mt-4">
                <div class="text-muted">Remaining</div>
                <div id="remaining" class="h2 font-weight-bold mb-0">-</div>
            </div>
            <hr />
            <div class="text-muted mb-2">Drawn IDs</div>
            <div id="history"></div>
        </div>
    </div>

    <div class="col-lg-9 text-center">
        <div id="winnerBox">&nbsp;</div>
        <div class="wheel-stage my-3">
            <div class="wheel-pointer"></div>
            <canvas id="wheel" width="560" height="560" style="max-width:100%;height:auto"></canvas>
            <div class="wheel-hub"></div>
        </div>
        <div>
            <button type="button" id="btnSpin" class="btn btn-primary" disabled>SPIN</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    (function () {
        var canvas = document.getElementById("wheel");
        var ctx = canvas.getContext("2d");
        var colors = ["#e65727", "#3ca558", "#1f77b4", "#f2b01e", "#8e44ad", "#16a6a6"];
        var segs = [];
        var rot = 0;
        var spinning = false;

        function draw() {
            var size = canvas.width, r = size / 2, outer = r - 10;
            ctx.clearRect(0, 0, size, size);

            if (!segs.length) {
                ctx.beginPath(); ctx.arc(r, r, outer, 0, 2 * Math.PI);
                ctx.fillStyle = "#ddd"; ctx.fill();
                return;
            }

            var n = segs.length, arc = 2 * Math.PI / n;
            var fs = n > 16 ? 20 : (n > 8 ? 26 : 34);

            for (var i = 0; i < n; i++) {
                var a0 = rot + i * arc;
                ctx.beginPath();
                ctx.moveTo(r, r);
                ctx.arc(r, r, outer, a0, a0 + arc);
                ctx.closePath();
                ctx.fillStyle = colors[i % colors.length];
                ctx.fill();
                ctx.strokeStyle = "#fff"; ctx.lineWidth = 2; ctx.stroke();

                ctx.save();
                ctx.translate(r, r);
                ctx.rotate(a0 + arc / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = "#fff";
                ctx.font = "bold " + fs + "px Segoe UI, Arial, sans-serif";
                ctx.fillText(segs[i], outer - 20, fs / 3);
                ctx.restore();
            }

            ctx.beginPath(); ctx.arc(r, r, outer, 0, 2 * Math.PI);
            ctx.lineWidth = 8; ctx.strokeStyle = "#333"; ctx.stroke();
        }

        function setRemaining(n) {
            $("#remaining").text(n);
            $("#btnSpin").prop("disabled", !(n > 0) || spinning || !$("#campaignId").val());
        }

        function loadState() {
            $("#winnerBox").removeClass("pop").html("&nbsp;");
            $("#history").empty();
            var id = $("#campaignId").val();
            if (!id) { segs = []; rot = 0; draw(); $("#remaining").text("-"); $("#btnSpin").prop("disabled", true); return; }
            $.getJSON('@Url.Action("WheelState", "Home")', { campaignId: id }, function (s) {
                segs = s.WheelIds || [];
                draw();
                setRemaining(s.RemainingCount);
            });
        }

        function animateTo(winnerIndex, done) {
            var n = segs.length, arc = 2 * Math.PI / n, TWO_PI = 2 * Math.PI;
            // Pointer is at the top (-90deg). Land the centre of the winning segment there.
            var base = -Math.PI / 2 - (winnerIndex + 0.5) * arc;
            var delta = (((base - rot) % TWO_PI) + TWO_PI) % TWO_PI + 7 * TWO_PI;
            var start = rot, duration = 7000, t0 = null;

            function step(ts) {
                if (t0 === null) t0 = ts;
                var p = Math.min((ts - t0) / duration, 1);
                var eased = 1 - Math.pow(1 - p, 4); // ease-out
                rot = start + delta * eased;
                draw();
                if (p < 1) requestAnimationFrame(step); else done();
            }
            requestAnimationFrame(step);
        }

        $("#campaignId").on("change", loadState);

        $("#btnSpin").on("click", function () {
            var id = $("#campaignId").val();
            if (!id || spinning) return;
            spinning = true;
            $("#btnSpin").prop("disabled", true);
            $("#winnerBox").removeClass("pop").html("&nbsp;");

            // The server picks the winner and marks it Withdrawn immediately.
            $.post('@Url.Action("DoSpin", "Home")', { campaignId: id }, function (s) {
                debugger;
                if (!s.Success) {
                    spinning = false;
                    bootbox.alert(s.Message || "Spin failed");
                    setRemaining(s.RemainingCount || 0);
                    return;
                }
                segs = s.WheelIds;
                var idx = segs.indexOf(s.WinnerId);
                animateTo(idx, function () {
                    spinning = false;
                    $("#winnerBox").text(s.WinnerId).addClass("pop");
                    $("#history").prepend('<div class="history-item">#' + s.WinnerId + '</div>');
                    setRemaining(s.RemainingCount);
                });
            }, "json").fail(function (e) {
                debugger;
                spinning = false;
                bootbox.alert("Spin failed, please try again.");
                $("#btnSpin").prop("disabled", false);
            });
        });

        draw();

        $.getJSON('@Url.Action("Campaigns", "Home")', function (list) {
            $.each(list, function (_, c) {
                $("#campaignId").append($("<option>").val(c.Value).text(c.Text));
            });
        });
    })();
</script>
