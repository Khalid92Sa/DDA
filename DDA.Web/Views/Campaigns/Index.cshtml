@model List<DDA.ViewModels.Campaigns.CampaignViewModel>
@{
    ViewBag.Title = DDA.Resources.Resource.Campaigns;
}

<div class="d-flex justify-content-end mb-3">
    <a href="@Url.Action("Add", "Campaigns")" class="btn btn-primary">
        <i class="fas fa-plus mr-2"></i>@DDA.Resources.Resource.Campaign_Add
    </a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th style="width:80px">#</th>
            <th>@DDA.Resources.Resource.Campaign_Name</th>
            <th style="width:160px">@DDA.Resources.Resource.Campaign_Records</th>
            <th style="width:120px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.EntriesCount</td>
                <td>
                    <a href="@Url.Action("Edit", "Campaigns", new { id = c.Id })" class="btn btn-sm btn-secondary">@DDA.Resources.Resource.Common_Edit</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-center text-muted">@DDA.Resources.Resource.Campaign_NoData</td></tr>
        }
    </tbody>
</table>
